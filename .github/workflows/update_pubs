name: Weekly Publication Update

on:
  schedule:
    # Runs every Monday at 08:00 UTC (Cron syntax: minute hour day-of-month month day-of-week)
    - cron: '0 8 * * 1'
  workflow_dispatch: # Adds a manual "Run workflow" button in the GitHub Actions UI

jobs:
  update-data:
    runs-on: ubuntu-latest
    steps:
      - name: Check out repository
        uses: actions/checkout@v4

      - name: Set up R environment
        uses: r-lib/actions/setup-r@v2
        with:
          r-version: 'release'

      - name: Install system dependencies & R packages
        run: |
          # Install Linux system packages required for networking (httr2/curl)
          sudo apt-get update
          sudo apt-get install -y libcurl4-openssl-dev libssl-dev
          
          # Install R package dependencies
          Rscript -e 'install.packages(c("orcidtr", "httr2", "dplyr", "tibble", "magrittr", "purrr"))'

      - name: Run publication fetch script
        run: |
          Rscript scripts/update_pubs.R

      - name: Commit and Push updated data
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add data/
          git commit -m "Auto-update publication list [weekly]" || exit 0
          git push
